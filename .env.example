# NashFit — environment variables (template)
#
# Copy to .env.local and fill in. .env.local is gitignored and must never
# be committed. This file is committed and must never contain real values.
#
# EXPO_PUBLIC_ prefix = inlined into the JS bundle at build time and
# extractable by anyone who downloads the app. Only put values here that are
# public by design. See docs/nashfit-environment-setup.md.
#
# NEVER put these in this file or .env.local:
#   - Supabase secret key (sb_secret_...)  — bypasses RLS, total compromise
#   - Claude API key
#   - RevenueCat webhook secret
# Those are Edge Function secrets, set with `supabase secrets set`.

# Which environment this build targets: development | production
# Read by app.config.ts at build time to pick the bundle identifier and app name.
APP_ENV=development

# Supabase — project URL and publishable key (Settings → API Keys).
# Use the new sb_publishable_ key, not the legacy anon JWT: legacy keys are
# deprecated by end of 2026. The publishable key is public by design; Row
# Level Security is what actually protects the data (build-plan task 0.6).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# PostHog — project token (aka project API key, starts phc_) and region host.
# Settings → Project → Project token. Not the Project ID, and not a personal
# API key (phx_), which is private.
# US region: https://us.i.posthog.com
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry — client DSN for the mobile app (task 0.9). Safe to expose.
EXPO_PUBLIC_SENTRY_DSN=
