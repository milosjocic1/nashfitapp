{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  // Edge Functions are Deno, not React Native: they use Deno globals, JSR/npm
  // specifier imports and their own deno.json. Compiling them with the app's
  // config produces errors that mean nothing. They are type-checked by the
  // Deno toolchain instead, and by `supabase functions deploy`.
  "exclude": ["node_modules", "supabase/functions"]
}
